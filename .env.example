# ZeroFee self-host settings. Copy this file to .env (cp .env.example .env) and fill in only what you want.
# EVERY key is optional: with an empty .env the app runs, the wallet uses sample money, and Trade reads the market from
# GeckoTerminal's free public API. Use your OWN keys. Never commit .env (it is in .gitignore).
# Read by tools/selfhost/serve.mjs (the relay half of `make selfhost`). A value already set in your shell wins.
# The relay's own full list, one line each: apps/quotes/.env.example.

# ── Where it listens ───────────────────────────────────────────────────────────────────────────────────────────────
# Port and host for the page and its relay (one origin). Keep localhost:5180 unless you also set ALLOWED_ORIGINS.
PORT=5180
HOST=localhost
# Extra web origins the relay answers, comma-separated (e.g. https://wallet.example.org when you serve it behind a domain).
ALLOWED_ORIGINS=
# Set to 1 only behind your own reverse proxy that sets x-real-ip; the relay then rate-limits by that address.
RELAY_TRUST_PROXY=

# ── Trade: market data (CoinGecko / GeckoTerminal) ──────────────────────────────────────────────────────────────
# A CoinGecko API key for on-chain pools and charts. A free Demo key works: https://www.coingecko.com/en/api
GECKOTERMINAL_API_KEY=
# "demo" for a free Demo key; leave empty for a paid (Pro) key.
GECKOTERMINAL_KEY_PLAN=
# A CoinGecko key for coin prices (may be the same key as above), and its plan ("demo" or empty for Pro).
COINGECKO_API_KEY=
COINGECKO_KEY_PLAN=
# The relay's own daily cap on CoinGecko calls (default 10000).
MARKET_DAILY_CALLS=

# ── Swaps and moves: NEAR Intents (1Click) ──────────────────────────────────────────────────────────────────────
# Your 1Click partner key (a JWT) from https://partners.near-intents.org. Without it, quote routes answer "not set up".
ONECLICK_JWT=
# Any long random string, e.g. `openssl rand -base64 32`. Needed together with ONECLICK_JWT. Changing it orphans
# quotes in flight.
STATUS_TAG_SECRET=
# Quote requests a day for the whole relay (default in apps/quotes/relay.mjs).
QUOTES_DAILY=
# "on" lets a new account's first money go through a confidential quote (capped at $25). Off when empty.
RELAY_FUND_CONFIDENTIAL=

# ── Chain access ────────────────────────────────────────────────────────────────────────────────────────────────
# A Helius key for sending signed Solana transactions through the relay (https://www.helius.dev).
HELIUS_API_KEY_RELAY=
# Sends a minute and a day for the whole relay (defaults 120 and 10000), and 1 to accept sends only from your origins.
SOL_SEND_MINUTE=
SOL_SEND_DAILY=
SOL_SEND_REQUIRE_ORIGIN=
# 0 to accept NEAR sends without an Origin header (default: an Origin is required).
NEAR_SEND_REQUIRE_ORIGIN=
# A FastNEAR key for NEAR reads (https://fastnear.com). Without it the app reads the free public NEAR nodes.
FASTNEAR_API_KEY=
# A second paid NEAR node (its URL, key inside) and a short name for it.
NEAR_DOOR2_URL=
NEAR_DOOR2_NAME=
# An Alchemy key for the Robinhood Chain node.
ALCHEMY_API_KEY=

# ── AgentZero (the in-app assistant) ────────────────────────────────────────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com). Without it AgentZero's chat is off.
ANTHROPIC_API_KEY=
# A long random secret that signs AgentZero's sign-up tokens (e.g. `openssl rand -base64 32`).
AGENTZERO_TOKEN_SECRET=
# A long random secret (32+ bytes) that hashes every key the relay stores; needed before anything goes to Redis.
AGENTZERO_STORE_KEY=
# The NEAR account that receives AgentZero's per-reply payments. Leave empty to keep paid mode off.
AGENTZERO_RECEIVE_ACCOUNT=
# Spending ceilings in US dollars of model cost (defaults in apps/quotes/agentzero.mjs and agentzero-sim.mjs):
AGENTZERO_DAILY=
AGENTZERO_DAILY_USD=
AGENTZERO_ALLOWANCE_USD=
AGENTZERO_TOKEN_DAILY_USD=
AGENTZERO_PAID_DAILY_USD=
AGENTZERO_FIRST_DAILY_USD=
AGENTZERO_SIM_DAILY_USD=
AGENTZERO_SIM_PER_IP_USD=
# A token for automated tests of the paid flow only. Leave empty.
AGENTZERO_TEST_TOKEN=

# ── Shared storage (optional: limits across several instances, alerts, pairing) ─────────────────────────────────────
# An Upstash Redis (REST) URL and token, or Vercel KV's pair below. Without one, each instance counts in memory.
ALERTS_REDIS_URL=
ALERTS_REDIS_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# A separate Redis for the "keep" store (must not be the same as the one above).
KEEP_REDIS_URL=
KEEP_REDIS_TOKEN=
# The email-alerts store: a different database from the shared one. Unset: alerts are off.
ALERTS_STORE_URL=
ALERTS_STORE_TOKEN=

# ── Email alerts (optional) ─────────────────────────────────────────────────────────────────────────────────────
# A Resend key and the From line, e.g. "Wallet alerts <alerts@your-domain>".
RESEND_API_KEY=
ALERTS_FROM=
# The relay's public https address (required for alerts), a cron secret, an operator email, and an account cap.
ALERTS_PUBLIC_URL=
CRON_SECRET=
ALERTS_OPERATOR_EMAIL=
ALERTS_MAX_ACCOUNTS=

# ── Debug traces (optional) ─────────────────────────────────────────────────────────────────────────────────────
# A token that may read stored traces (GET /v0/trace/...). Leave empty to keep the route off.
TRACE_READ_TOKEN=
