{
  "name": "@zerofee/extension",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.worker.config.ts && vite build -c vite.content.config.ts && vite build -c vite.app.config.ts && ZF_REQUIRE_BUILD=1 node --test src/manifest-csp.test.ts src/worker-build.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
