# The relay's settings (apps/quotes). Copy to apps/quotes/.env (or the repo's .env) and fill in only what you want.
# Every one is optional. Use your OWN keys; never commit .env. Read by tools/selfhost/serve.mjs, or set them in your host
# (for example Vercel's project settings) when you deploy apps/quotes yourself.

# ── Where it listens (tools/selfhost/serve.mjs only) ────────────────────────────────────────────────────────────
# Port and host. Relay dev next to `npm run dev`: PORT=5181, then build the app with VITE_ZEROFEE_RELAY=http://localhost:5181.
PORT=
HOST=
# Extra web origins the relay answers, comma-separated (your site's https origin).
ALLOWED_ORIGINS=
# 1 only behind your own proxy that sets x-real-ip (rate limits then use it).
RELAY_TRUST_PROXY=

# ── Market data ───────────────────────────────────────────────────────────────────────────────────────────────────
# CoinGecko on-chain key (pools, charts) and its plan ("demo" or empty for Pro).
GECKOTERMINAL_API_KEY=
GECKOTERMINAL_KEY_PLAN=
# CoinGecko key for coin prices and its plan ("demo" or empty for Pro).
COINGECKO_API_KEY=
COINGECKO_KEY_PLAN=
# The relay's daily cap on market calls.
MARKET_DAILY_CALLS=

# ── NEAR Intents (1Click) ─────────────────────────────────────────────────────────────────────────────────────────
# Your 1Click partner key (a JWT, partners.near-intents.org). Unset: quote routes say "not set up".
ONECLICK_JWT=
# A long random string (openssl rand -base64 32) that tags quote status links. Needed with ONECLICK_JWT.
STATUS_TAG_SECRET=
# Quote requests a day for the whole relay.
QUOTES_DAILY=
# "on": a new account's first money may go through a confidential quote (capped).
RELAY_FUND_CONFIDENTIAL=

# ── Chain nodes (keys stay on the relay) ──────────────────────────────────────────────────────────────────────────
# Helius key for sending signed Solana transactions.
HELIUS_API_KEY_RELAY=
# Solana sends a minute and a day; 1 to take sends only from your origins.
SOL_SEND_MINUTE=
SOL_SEND_DAILY=
SOL_SEND_REQUIRE_ORIGIN=
# FastNEAR key for NEAR reads and sends.
FASTNEAR_API_KEY=
# A second paid NEAR node: its URL (key inside it) and a short name for it.
NEAR_DOOR2_URL=
NEAR_DOOR2_NAME=
# 0 to take NEAR sends without an Origin header.
NEAR_SEND_REQUIRE_ORIGIN=
# Alchemy key for the Robinhood Chain node.
ALCHEMY_API_KEY=

# ── AgentZero (the helper's chat) ─────────────────────────────────────────────────────────────────────────────────
# Your Anthropic API key. Unset: AgentZero's chat is off.
ANTHROPIC_API_KEY=
# A long random secret that signs AgentZero's sign-up tokens.
AGENTZERO_TOKEN_SECRET=
# A long random secret (32+ bytes) that hashes every key the relay stores.
AGENTZERO_STORE_KEY=
# The NEAR account paid per reply. Empty: paid mode is off.
AGENTZERO_RECEIVE_ACCOUNT=
# Spending caps in US dollars of model cost (whole relay, per token, paid, first day, sample mode, per address).
AGENTZERO_DAILY=
AGENTZERO_DAILY_USD=
AGENTZERO_ALLOWANCE_USD=
AGENTZERO_TOKEN_DAILY_USD=
AGENTZERO_PAID_DAILY_USD=
AGENTZERO_FIRST_DAILY_USD=
AGENTZERO_SIM_DAILY_USD=
AGENTZERO_SIM_PER_IP_USD=
# A token for automated tests of the paid flow. Leave empty.
AGENTZERO_TEST_TOKEN=

# ── Shared storage (Upstash Redis REST) ───────────────────────────────────────────────────────────────────────────
# Limits shared across instances, and pairing. Either pair works.
ALERTS_REDIS_URL=
ALERTS_REDIS_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The "keep" store: a different database from the one above.
KEEP_REDIS_URL=
KEEP_REDIS_TOKEN=
# The email-alerts store: a different database from the shared one. Unset: alerts are off.
ALERTS_STORE_URL=
ALERTS_STORE_TOKEN=

# ── Email alerts ──────────────────────────────────────────────────────────────────────────────────────────────────
# Resend key and the From line ("Wallet alerts <alerts@your-domain>").
RESEND_API_KEY=
ALERTS_FROM=
# The relay's public https address, a cron secret, an operator email, and a cap on accounts.
ALERTS_PUBLIC_URL=
CRON_SECRET=
ALERTS_OPERATOR_EMAIL=
ALERTS_MAX_ACCOUNTS=

# ── Debug traces ──────────────────────────────────────────────────────────────────────────────────────────────────
# A token that may read stored traces. Empty: the route is off.
TRACE_READ_TOKEN=

# Set by the host, not by you: VERCEL, VERCEL_ENV ("production" answers only the app's own origins), VERCEL_REGION.
