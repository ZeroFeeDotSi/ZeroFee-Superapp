{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src",
    "../../packages/design/src",
    "../../packages/shell-api/src"
  ],
  "exclude": [
    "../../packages/**/*.test.ts",
    "src/**/*.test.ts",
    "src/hosting.ts"
  ]
}
