#!/bin/sh
# Refuses a commit message that names the author, a place, a local time or a private session link (patterns:
# .git/info/leak-patterns, private to each clone), or that holds a secret's shape (tools/hooks/secret-shapes.mjs).
P="$(cd "$(git rev-parse --git-common-dir)" && pwd)/info/leak-patterns"
if [ -f "$P" ]; then
  grep -v '^#' "$P" | grep -v '^$' | while IFS= read -r p; do
    if grep -v '^#' "$1" | grep -Eiq -- "$p"; then echo "leak-guard: the commit message matches a private pattern"; exit 1; fi
  done || exit 1
fi
node "$(dirname "$0")/secret-shapes.mjs" --file "$1" || exit 1
